"Schema: <code>[LOCATION]-SRV-[PURPOSE][NUMBER]</code> &mdash; 14 characters"
msgstr "Schema: <code>[STANDORT]-SRV-[ZWECK][NUMMER]</code> &mdash; 14 Zeichen"

msgid "Free-text Purpose"
msgstr "Freitext-Zweck"

msgid "Max. 4 characters, A–Z / 0–9"
msgstr "Max. 4 Zeichen, A–Z / 0–9"

msgid ""
"Schema: <code>[LOCATION]-PC-[IDENTIFIER]</code> &mdash; max. 15 characters"
msgstr "Schema: <code>[STANDORT]-PC-[KENNUNG]</code> &mdash; max. 15 Zeichen"

