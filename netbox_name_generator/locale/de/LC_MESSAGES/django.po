msgid ""
"Schema: <code>[LOCATION]-[TYPE]-[FUNCTION][NUMBER][RACKID]</code> &mdash; "
"exactly 15 characters"
msgstr ""
"Schema: <code>[STANDORT]-[TYP]-[FUNKTION][NUMMER][RACKID]</code> &mdash; "
"genau 15 Zeichen"

msgid "Example:"
msgstr "Beispiel:"

