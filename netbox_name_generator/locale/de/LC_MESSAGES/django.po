msgstr "Bitte einen Systemtyp auswählen."

msgid "Unknown system type:"
msgstr "Unbekannter Systemtyp:"

#, python-format
msgid ""
"The name \"%(name)s\" was just reserved by another, concurrent request. "
"Please try again."
msgstr ""
"Der Name \"%(name)s\" wurde soeben durch eine gleichzeitige Anfrage "
"reserviert. Bitte erneut versuchen."

msgid "Please select a site for the network device."
msgstr "Bitte einen Standort für das Netzwerkgerät wählen."

msgid "Please select a device type."
msgstr "Bitte einen Gerätetyp wählen."

msgid "Please enter a Rack ID."
msgstr "Bitte eine Rack-ID eingeben."

msgid "Please select a function for the network device."
msgstr "Bitte eine Funktion für das Netzwerkgerät wählen."

msgid "Please select a site for the server."
msgstr "Bitte einen Standort für den Server wählen."

msgid "Please enter a free-text purpose."
msgstr "Bitte einen Freitext-Zweck eingeben."

msgid "Please select a purpose for the server."
msgstr "Bitte einen Zweck für den Server wählen."

msgid "Please select a site for the PC."
msgstr "Bitte einen Standort für den PC wählen."

msgid "Please enter a code or inventory number."
msgstr "Bitte ein Kürzel oder eine Inventarnummer eingeben."

msgid "Please enter a user code."
msgstr "Bitte ein Benutzerkürzel eingeben."

msgid "Please select an area for the VM."
msgstr "Bitte einen Bereich für die VM wählen."

msgid "Please enter a free-text function."
msgstr "Bitte eine Freitext-Funktion eingeben."

msgid "Please select a function for the VM."
msgstr "Bitte eine Funktion für die VM wählen."

msgid "NetBox Site"
msgstr "NetBox-Site"

msgid "Link to NetBox site – pre-filled when creating a device."
msgstr ""
"Verknüpfung mit dem NetBox-Standort – wird beim Gerät-Anlegen vorausgefüllt."

msgid "Only uppercase letters (A–Z) and digits (0–9) allowed."
msgstr "Nur Großbuchstaben (A–Z) und Ziffern (0–9) erlaubt."

msgid "The characters < and > are not allowed."
msgstr "Die Zeichen < und > sind nicht erlaubt."

msgid "Without Rack Suffix (number unique per location/type/function)"
msgstr "Ohne Rack-Suffix (Nummer eindeutig je Standort/Typ/Funktion)"

msgid ""
"Full Name (number unique per rack — same number may appear in different "
"racks)"
msgstr ""
"Vollständiger Name (Nummer eindeutig je Rack – dieselbe Nummer darf in "
"verschiedenen Racks vorkommen)"

msgid "Cross-location (number globally unique per type/function)"
msgstr "Standortübergreifend (Nummer global eindeutig je Typ/Funktion)"

msgid "Location-local (number unique per location/purpose)"
msgstr "Standortbezogen (Nummer eindeutig je Standort/Zweck)"

msgid "Cross-location (number globally unique per purpose)"
msgstr "Standortübergreifend (Nummer global eindeutig je Zweck)"

msgid "Abbreviation"
msgstr "Kürzel"

msgid "Description"
msgstr "Beschreibung"

msgid "Sites"
msgstr "Standorte"

msgid "Has Function"
msgstr "Hat Funktion"

msgid "Disable for types without function abbreviation (e.g. AP)"
msgstr "Deaktivieren für Typen ohne Funktionskürzel (z. B. AP)"

msgid "Counting Strategy"
msgstr "Zählstrategie"

msgid "Determines how duplicate numbers are detected when generating names."
msgstr ""
"Legt fest, wie doppelte Nummern beim Erzeugen von Namen erkannt werden."

